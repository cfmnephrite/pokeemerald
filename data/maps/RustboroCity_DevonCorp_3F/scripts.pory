const OBJ_EVENT_ID_STONE		=	1
const OBJ_EVENT_ID_GUARD_1		=	4
const OBJ_EVENT_ID_GUARD_2		=	5
const OBJ_EVENT_ID_GUARD_3		=	6
const OBJ_EVENT_ID_GUARD_4		=	7


mapscripts RustboroCity_DevonCorp_3F_MapScripts {
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_RUSTBORO_CITY_STATE, 1: RustboroCity_DevonCorp_3F_EventScript_JosephStoneIntro
	]
}

script RustboroCity_DevonCorp_3F_EventScript_JosephStoneIntro {
	setvar(VAR_RUSTBORO_CITY_STATE, 2)
	lock
	special(SpawnCameraObject)
	applymovement(OBJ_EVENT_ID_CAMERA, RustboroCity_DevonCorp_3F_Movement_CameraEntrance)
	applymovement(OBJ_EVENT_ID_GUARD_1, RustboroCity_DevonCorp_3F_Movement_Guard1Entrance)
	applymovement(OBJ_EVENT_ID_GUARD_2, RustboroCity_DevonCorp_3F_Movement_Guard2Entrance)
	applymovement(OBJ_EVENT_ID_PLAYER, RustboroCity_DevonCorp_3F_Movement_PlayerEntrance)
	waitmovement(0)
	delay(60)
	msgbox(RustboroCity_DevonCorp_3F_Text_JosephStone1, MSGBOX_AUTOCLOSE)
	setvar(VAR_0x8004, 1)   // vertical pan
	setvar(VAR_0x8005, 1)   // horizontal pan
	setvar(VAR_0x8006, 16)  // num shakes
	setvar(VAR_0x8007, 3)   // shake delay
	special(ShakeCamera)
	playse(SE_EFFECTIVE)
	goto(RustboroCity_DevonCorp_3F_EventScript_SuddenLargeNoise)
}

script RustboroCity_DevonCorp_3F_EventScript_SuddenLargeNoise {
	applymovement(OBJ_EVENT_ID_GUARD_1, Common_Movement_ExclamationMark)
	applymovement(OBJ_EVENT_ID_GUARD_2, Common_Movement_ExclamationMark)
	applymovement(OBJ_EVENT_ID_GUARD_3, Common_Movement_ExclamationMark)
	applymovement(OBJ_EVENT_ID_GUARD_4, Common_Movement_ExclamationMark)
	applymovement(OBJ_EVENT_ID_STONE, Common_Movement_ExclamationMark)
	waitmovement(0)
	delay(60)
	msgbox(format("...what the hell was that?"))
	applymovement(OBJ_EVENT_ID_GUARD_4, Common_Movement_WalkInPlaceDown)
	waitmovement(0)
	applymovement(OBJ_EVENT_ID_STONE, Common_Movement_WalkInPlaceUp)
	waitmovement(0)
	msgbox(RustboroCity_DevonCorp_3F_Text_RareRocksGuard4Dialogue)
	applymovement(OBJ_EVENT_ID_STONE, Common_Movement_WalkInPlaceLeft)
	waitmovement(0)
	msgbox(RustboroCity_DevonCorp_3F_Text_JosephStone2)
	applymovement(OBJ_EVENT_ID_GUARD_1, Common_Movement_WalkInPlaceRight)
	applymovement(OBJ_EVENT_ID_GUARD_2, Common_Movement_WalkInPlaceRight)
	waitmovement(0)
	msgbox("Yes, sir!")
	applymovement(OBJ_EVENT_ID_GUARD_1, RustboroCity_DevonCorp_3F_Guard1WalkRightFaceDown)
	applymovement(OBJ_EVENT_ID_GUARD_2, RustboroCity_DevonCorp_3F_Guard2WalkRightFaceUp)
	applymovement(OBJ_EVENT_ID_PLAYER, RustboroCity_DevonCorp_3F_PlayerLookUpAndDown)
	msgbox("Let's go, newbie!")
	waitmovement(0)
	applymovement(OBJ_EVENT_ID_GUARD_1, Common_Movement_WalkLeft3)
	applymovement(OBJ_EVENT_ID_GUARD_2, Common_Movement_WalkLeft3)
	applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkLeft3)
	waitmovement(0)
	warp(MAP_RUSTBORO_CITY_DEVON_CORP_2F, 255, 2, 2)
	end
}

script RustboroCity_DevonCorp_3F_EventScript_RareRocksDisplay {
	msgbox(RustboroCity_DevonCorp_3F_Text_RareRocksDisplay, MSGBOX_SIGN)
}

text RustboroCity_DevonCorp_3F_Text_JosephStone1 {
	format(
		"TEXT"
		// "I'm very busy so I won't keep you for long.\p"
		// "My name is Stone and I'm the President of the Board of the Devon Corporation.\p"
		// "I simply wanted to thank you for saving our truck in Petalburg.\p"
		// "Truly, you put most of security forces to shame!\p"
		// "I am prepared to pay 5,000 for service rendered and more for future work.\p"
		// "Which brings me to my next point...\p"
		// "I need reliable Trainers to escort some goods from Rustborough to Slateport.\p"
		// "And to be honest... I can't trust my own men at the moment.\p"
		// "So I need somebody unknown on this mission.\p"
		// "The ship is called the Aurorus and it will depart from Rustborough Port.\p"
		// "Go the port when it arrives and the men will sort you out.\p"
		// "I am offering you 10,000 for the job and-"
	)
}

text RustboroCity_DevonCorp_3F_Text_RareRocksDisplay {
	"It's a collection of rare rocks and\n"
	"stones assembled by the President."
}

text RustboroCity_DevonCorp_3F_Text_RareRocksGuard4Dialogue {
	format(
		"Sir! Security downstairs say there's been a breach!\p"
		"Magma activists have stormed the rear entrance to the building!\p"
		"We have to take you to the helipad!"
	)
}

text RustboroCity_DevonCorp_3F_Text_JosephStone2 {
	format(
		"I see...\p"
		"Well, aren't we lucky?\p"
		"What an excellent opportunity to put your skills to use!\p"
		"You three, go downstairs and deal with these terrorists!\p"
		"I have to get out of here as soon as possible..."
	)
}

movement RustboroCity_DevonCorp_3F_Movement_Guard1Entrance {
	walk_up * 5
	walk_right * 2
}

movement RustboroCity_DevonCorp_3F_Movement_Guard2Entrance {
	walk_up * 3
	walk_in_place_right
}

movement RustboroCity_DevonCorp_3F_Movement_PlayerEntrance {
	walk_up * 4
	walk_right * 2
}

movement RustboroCity_DevonCorp_3F_Movement_CameraEntrance {
	walk_diag_northeast * 4
	walk_slow_right * 3
}

movement RustboroCity_DevonCorp_3F_Guard1WalkRightFaceDown {
	walk_right
	face_down
}

movement RustboroCity_DevonCorp_3F_Guard2WalkRightFaceUp {
	walk_right
	face_up
}

movement RustboroCity_DevonCorp_3F_PlayerLookUpAndDown {
	face_down
	delay_16
	face_up
	delay_16
	face_down
}
