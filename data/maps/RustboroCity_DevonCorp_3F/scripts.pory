const OBJ_EVENT_ID_GUARD_1		=	4
const OBJ_EVENT_ID_GUARD_2		=	5


mapscripts RustboroCity_DevonCorp_3F_MapScripts {
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_RUSTBORO_CITY_STATE, 1: RustboroCity_DevonCorp_3F_EventScript_JosephStone
	]
}

script RustboroCity_DevonCorp_3F_EventScript_JosephStone {
	setvar(VAR_RUSTBORO_CITY_STATE, 2)
	lock
	special(SpawnCameraObject)
	applymovement(OBJ_EVENT_ID_CAMERA, RustboroCity_DevonCorp_3F_Movement_CameraEntrance)
	applymovement(OBJ_EVENT_ID_GUARD_1, RustboroCity_DevonCorp_3F_Movement_Guard1Entrance)
	applymovement(OBJ_EVENT_ID_GUARD_2, RustboroCity_DevonCorp_3F_Movement_Guard2Entrance)
	applymovement(OBJ_EVENT_ID_PLAYER, RustboroCity_DevonCorp_3F_Movement_PlayerEntrance)
	waitmovement(0)
	delay(60)
	msgbox(RustboroCity_DevonCorp_3F_Text_JosephStone1, MSGBOX_AUTOCLOSE)
	end
}

script RustboroCity_DevonCorp_3F_EventScript_RareRocksDisplay {
	msgbox(RustboroCity_DevonCorp_3F_Text_RareRocksDisplay, MSGBOX_SIGN)
}

text RustboroCity_DevonCorp_3F_Text_JosephStone1 {
	format(
		"I'm very busy so I won't keep you for long.\p"
		"My name is Stone and I'm the President of the Board of the Devon Corporation.\p"
		"I simply wanted to thank you for saving our truck in Petalburg.\p"
		"Truly, you put most of security forces to shame!\p"
		"I am prepared to pay 5,000 for service rendered and more for future work.\p"
		"Which brings me to my next point...\p"
		"I need reliable Trainers to escort some goods from Rustborough to Slateport.\p"
		"Be at the harbour when it arrives and the men will sort you out.\p"
		"I am offering you 10,000 for the job and-"
	)
}

text RustboroCity_DevonCorp_3F_Text_RareRocksDisplay {
	"It's a collection of rare rocks and\n"
	"stones assembled by the President."
}

movement RustboroCity_DevonCorp_3F_Movement_Guard1Entrance {
	walk_up * 5
	walk_right * 2
}

movement RustboroCity_DevonCorp_3F_Movement_Guard2Entrance {
	walk_up * 3
	walk_in_place_right
}

movement RustboroCity_DevonCorp_3F_Movement_PlayerEntrance {
	walk_up * 4
	walk_right * 2
}

movement RustboroCity_DevonCorp_3F_Movement_CameraEntrance {
	walk_diag_northeast * 4
	walk_slow_right * 3
}
