script PetalburgWoods_EventScript_SecondSpecialDoubleBattleOver {
	msgbox("Damn, this is over", MSGBOX_AUTOCLOSE)
}

movement PetalburgWoods_Movement_Grunt1MovesIntoBattlePosition {
	walk_down
	walk_right * 2
}

movement PetalburgWoods_Movement_Grunt2MovesIntoBattlePosition {
	walk_right
	walk_down
	face_right
}

movement PetalburgWoods_Movement_Grunt3MovesIntoBattlePosition {
	walk_left *2
	walk_up * 2
}

movement PetalburgWoods_Movement_Grunt4MovesIntoBattlePosition {
	walk_up * 2
	walk_left * 2
}

movement PetalburgWoods_Movement_Grunts12DefeatedLockRightWalkLeft {
	lock_facing_direction
	walk_left
	unlock_facing_direction
}

movement PetalburgWoods_Movement_Grunt1Flees {
	walk_fastest_left
	walk_fastest_down * 6
	walk_fastest_right
	walk_fastest_down
}

movement PetalburgWoods_Movement_Grunt2Flees {
	walk_fastest_left
	walk_fastest_down * 7
	walk_fastest_right
	walk_fastest_down
}

movement PetalburgWoods_Movement_BrendanMovesIntoPosition1 {
	walk_fast_up * 2
	walk_fast_left * 2
	walk_fast_up * 5
	walk_fast_left
	walk_fast_up
	walk_fast_left
}

movement PetalburgWoods_Movement_BrendanMovesIntoPosition2 {
	walk_fast_up * 2
	walk_fast_left * 2
	walk_fast_up * 5
	walk_fast_left * 2
}

script PetalburgWoods_EventScript_BrendanSaysYouCantLeave {
	msgbox(PetalburgWoods_Text_BrendanSaysCantLeave, MSGBOX_SIGN)
	applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkUp)
	end
}

script PetalburgWoods_EventScript_Sign {
	setvar(VAR_PETALBURG_WOODS_STATE, 0)
	msgbox(PetalburgWoods_Text_Sign, MSGBOX_SIGN)
}

script PetalburgWoods_EventScript_Girl {
	switch(var(VAR_PETALBURG_WOODS_STATE)) {
		case 0:
		case 1:
			msgbox(PetalburgWoods_Text_GirlVar0Var1, MSGBOX_NPC)
		default:
			msgbox(PetalburgWoods_TextGirl, MSGBOX_NPC)	
	}
	end
}

script PetalburgWoods_EventScript_Boy3 {
	switch(var(VAR_PETALBURG_WOODS_STATE)) {
		case 0:
		case 1:
			if (!flag(FLAG_BERRY_PETALBURG_WOODS_RECEIVED_SITRUS)) {
				msgbox(format("Thank you, thank you, thank you! Here, take this!"))
				giveitem(ITEM_SITRUS_BERRY)
				setflag(FLAG_BERRY_PETALBURG_WOODS_RECEIVED_SITRUS)
			}
			msgbox("I was just walking and they grabbed me...", MSGBOX_NPC)
		default:
			if (!flag(FLAG_BERRY_PETALBURG_WOODS_RECEIVED_SITRUS)) {
				msgbox(format("Hey! Thank you for saving me from the Rockets!\pI have a present for you!"))
				giveitem(ITEM_SITRUS_BERRY)
				setflag(FLAG_BERRY_PETALBURG_WOODS_RECEIVED_SITRUS)
			}
			msgbox(PetalburgWoods_Text_Boy, MSGBOX_NPC)	
	}
	end
}

script PetalburgWoods_EventScript_Lyle {
	trainerbattle_single(TRAINER_LYLE, PetalburgWoods_Text_GoBugPokemonTeam, PetalburgWoods_Text_ICouldntWin)
	msgbox(PetalburgWoods_Text_ImOutOfPokeBalls, MSGBOX_AUTOCLOSE)
	end
}

script PetalburgWoods_EventScript_James {
	trainerbattle_single(TRAINER_JAMES_1, PetalburgWoods_Text_InstantlyPopularWithBugPokemon, PetalburgWoods_Text_CantBePopularIfILose, PetalburgWoods_EventScript_TryRegisterJames)
	specialvar(VAR_RESULT, ShouldTryRematchBattle)
	if (var(VAR_RESULT)) {
		goto(PetalburgWoods_EventScript_JamesRematch)
	}
	setvar(VAR_0x8004, TRAINER_JAMES_1)
	specialvar(VAR_RESULT, IsTrainerRegistered)
	if (!var(VAR_RESULT)) {
		goto(PetalburgWoods_EventScript_TryRegisterJames2)
	}
	msgbox(PetalburgWoods_Text_PeopleRespectYou, MSGBOX_DEFAULT)
	release
	end
}

script PetalburgWoods_EventScript_TryRegisterJames {
	special(PlayerFaceTrainerAfterBattle)
	waitmovement(0)
	if (flag(FLAG_HAS_MATCH_CALL)) {
		goto(PetalburgWoods_EventScript_RegisterJames)
	}
	release
	end
}

script PetalburgWoods_EventScript_JamesRematch {
	trainerbattle_rematch(TRAINER_JAMES_1, PetalburgWoods_Text_MyPokemonHaveGrown, PetalburgWoods_Text_CantBePopularIfILose)
	msgbox(PetalburgWoods_Text_IveBeenTrainingHard, MSGBOX_AUTOCLOSE)
	end
}

script PetalburgWoods_EventScript_TryRegisterJames2 {
	if (flag(FLAG_HAS_MATCH_CALL)) {
		goto(PetalburgWoods_EventScript_RegisterJames)
	}
	msgbox(PetalburgWoods_Text_PeopleRespectYou, MSGBOX_DEFAULT)
	release
	end
}

script PetalburgWoods_EventScript_RegisterJames {
	msgbox(PetalburgWoods_Text_IWantRematch, MSGBOX_DEFAULT)
	register_matchcall(TRAINER_JAMES_1)
	release
	end
}

script PetalburgWoods_EventScript_Boy1 {
	msgbox(PetalburgWoods_Text_StayOutOfTallGrass, MSGBOX_NPC)
	end
}

script PetalburgWoods_EventScript_Boy2 {
	msgbox(PetalburgWoods_Text_HiddenItemsExplanation, MSGBOX_NPC)
	end
}

// Episode text
text PetalburgWoods_Text_Grunt1Defeat {
	format("Useless bat! First it gives me some weird cough, now this!")
}

text PetalburgWoods_Text_Grunt2Defeat {
	format("Hmm, maybe actual training is better than Rare Candies...")
}

text PetalburgWoods_Text_Grunt3Defeat {
	format("Oh, the boss isn't going to like this...")
}

text PetalburgWoods_Text_Grunt4Defeat {
	format("How?! How can this be?!")
}

text PetalburgWoods_Text_BrendanIntro {
	format (
		"My name's Brendan\n"
		"My dad's a gym leader in Petalburg.\p"
		"And you are? {PLAYER}?\p"
		"Listen, {PLAYER}ey, there are two things you should know about me.\p"
		"The first is that my hair isn't white - it's a hat, see?\p"
		"The second is that I'll never turn down a chance to slap some bottom.\p"
		"So how about we go and take down the rest of these Rocket thugs, eh?"
	)
}

text PetalburgWoods_Text_BrendanIntro2 {
	"That's the spirit!\n"
	"Now let's go do this!"
}

text PetalburgWoods_Text_BrendanSaysCantLeave {
	format(
		"Where are you going?\n"
		"Come on, let's take 'em down!"
	)
}

// Random text

text PetalburgWoods_Text_Sign {
	"Petalburg Woods\n"
	"{DOWN_ARROW}Petalburg"
}

text PetalburgWoods_Text_GirlVar0Var1 {
	format(
		"What's going on?\p"
		"There's a crashed truck blocking the road and I hear angry men shouting..."
	)
}

text PetalburgWoods_TextGirl {
	format(
		"There used to be Shroomish around here!\p"
		"But I haven't seen any in a long time..."
	)
}

text PetalburgWoods_Text_Boy {
	format(
		"Those Rocket guys are scary...\nMy dad says they're not from Hoenn.\p"
		"He says we should stop all the foreigners coming in\pbecause they could be Rockets or drug dealers or French."
	)
}

text PetalburgWoods_Text_GoBugPokemonTeam {
	"I caught a whole bunch of monsters!\p"
	"Go, go, go!\n"
	"My Bug team!"
}

text PetalburgWoods_Text_ICouldntWin {
	"I have all these monsters,\n"
	"but I couldn't win…"
}

text PetalburgWoods_Text_ImOutOfPokeBalls {
	"I caught a bunch of monsters.\n"
	"Now I'm out of Monster Balls..."
}

text PetalburgWoods_Text_InstantlyPopularWithBugPokemon {
	"If you take Bug monsters to school,\n"
	"you get to be instantly popular!"
}

text PetalburgWoods_Text_CantBePopularIfILose {
	"I can't be popular if I lose."
}

text PetalburgWoods_Text_PeopleRespectYou {
	"If you have a big Bug monster,\n"
	"people respect you for it."
}

text PetalburgWoods_Text_IWantRematch {
	"I want a rematch when my Bug\n"
	"monsters grow up!\p"
	"I'm registering you in my PokéNav!"
}

text PetalburgWoods_Text_MyPokemonHaveGrown {
	"My Bug monsters have grown.\n"
	"I'll be popular again!"
}

text PetalburgWoods_Text_IveBeenTrainingHard {
	"You get to be popular if you have\n"
	"strong monsters, right?\l"
	"So, I've been training hard."
}

text PetalburgWoods_Text_StayOutOfTallGrass {
	"Yo, there!\n"
	"Your monsters doing okay?\p"
	"If your monsters are weak and you want\n"
	"to avoid battles, you should stay out\l"
	"of tall grass."
}

text PetalburgWoods_Text_HiddenItemsExplanation {
	"Sometimes, there are things on the\n"
	"ground even if you can't see them.\p"
	"That's why I always check where I'm\n"
	"walking."
}