const OBJ_EVENT_ID_GRUNT_1		=	13
const OBJ_EVENT_ID_GRUNT_2		=	14
const OBJ_EVENT_ID_BOY			=	16
const OBJ_EVENT_ID_GRUNT_3		=	1
const OBJ_EVENT_ID_GRUNT_4		=	15
const OBJ_EVENT_ID_DEVON_GUY	=	2
const OBJ_EVENT_ID_RANDOM_GIRL	=	11
const OBJ_EVENT_ID_BRENDAN		=	17
const OBJ_EVENT_ID_TRUCK		=	12

mapscripts PetalburgWoods_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		if (var(VAR_PETALBURG_WOODS_STATE) == 0) {
			setobjectxyperm(OBJ_EVENT_ID_RANDOM_GIRL, 16, 26)
			setobjectmovementtype(OBJ_EVENT_ID_RANDOM_GIRL, MOVEMENT_TYPE_LOOK_AROUND)
			setobjectxyperm(OBJ_EVENT_ID_BOY, 7, 8)
			setobjectmovementtype(OBJ_EVENT_ID_RANDOM_GIRL, MOVEMENT_TYPE_FACE_DOWN)
			addobject(OBJ_EVENT_ID_GRUNT_1)
			addobject(OBJ_EVENT_ID_GRUNT_2)
			addobject(OBJ_EVENT_ID_GRUNT_3)
			addobject(OBJ_EVENT_ID_GRUNT_4)
			addobject(OBJ_EVENT_ID_DEVON_GUY)
			addobject(OBJ_EVENT_ID_TRUCK)
		}
	}
}

script PetalburgWoods_EventScript_FirstEncounter_Position1 {
	setvar(VAR_TEMP_0, 1)
	goto(PetalburgWoods_EventScript_FirstEncounter)
}

script PetalburgWoods_EventScript_FirstEncounter_Position2 {
	setvar(VAR_TEMP_0, 2)
	goto(PetalburgWoods_EventScript_FirstEncounter)
}

script PetalburgWoods_EventScript_FirstEncounter {
	applymovement(OBJ_EVENT_ID_BOY, Common_Movement_WalkInPlaceDown)
	msgbox(
		"Boy: Please let me go!\n"
		"I won't tell anyone, I swear!"
	)
	applymovement(OBJ_EVENT_ID_GRUNT_1, Common_Movement_WalkInPlaceUp)
	msgbox(
		"Sorry, kid, you know how it is.\n"
		"Can't have any loose en-"
	)
	applymovement(OBJ_EVENT_ID_BOY, Common_Movement_ExclamationMarkLookRight)
	msgbox(
		"Boy: Oh, you!\n"
		"Please help meeee!"
	)
	playse(SE_PIN)
	applymovement(OBJ_EVENT_ID_GRUNT_1, Common_Movement_ExclamationMarkLookRight)
	applymovement(OBJ_EVENT_ID_GRUNT_2, Common_Movement_ExclamationMarkLookRight)
	waitmovement(0)
	msgbox(
		"Well, look what we have here..."
	)
	applymovement(OBJ_EVENT_ID_GRUNT_1, PetalburgWoods_Movement_Grunt1MovesIntoBattlePosition)
	applymovement(OBJ_EVENT_ID_GRUNT_2, PetalburgWoods_Movement_Grunt2MovesIntoBattlePosition)
	waitmovement(0)
	msgbox(
		"You trying to be a hero, kid?\p"
		"???: Wait a second, scumbags!"
	)
	addobject(OBJ_EVENT_ID_BRENDAN)
	switch(var(VAR_TEMP_0)) {
		case 1: applymovement(OBJ_EVENT_ID_BRENDAN, PetalburgWoods_Movement_BrendanMovesIntoPosition1)
		case 2: applymovement(OBJ_EVENT_ID_BRENDAN, PetalburgWoods_Movement_BrendanMovesIntoPosition2)
	}
	waitmovement(0)
	applymovement(OBJ_EVENT_ID_GRUNT_1, Common_Movement_WalkInPlaceRight)
	msgbox(
		"Oh, good! More fresh meat!\n"
		"All right, let's put you kids to bed."
	)
	goto(PetalburgWoods_EventScript_FirstSpecialDoubleBattle)
}

script PetalburgWoods_EventScript_FirstSpecialDoubleBattle {
	// multi_fixed_2_vs_2(TRAINER_PETALBURG_WOODS_GRUNT_1, PetalburgWoods_Text_Grunt1Defeat, TRAINER_PETALBURG_WOODS_GRUNT_2, PetalburgWoods_Text_Grunt2Defeat, TRAINER_PETALBURG_WOODS_BRENDAN, TRAINER_BACK_PIC_RUBY_SAPPHIRE_BRENDAN)
	// switch(var(VAR_RESULT)){
	// 	case 1:
	// 		setvar(VAR_PETALBURG_WOODS_STATE, 1)
	// 		goto(PetalburgWoods_EventScript_FirstSpecialDoubleBattleOver)
	// 	default:
	// 		fadescreen(FADE_TO_BLACK)
	// 		special(SetCB2WhiteOut)
	// 		waitstate
	// }
	setvar(VAR_PETALBURG_WOODS_STATE, 1)
	goto(PetalburgWoods_EventScript_FirstSpecialDoubleBattleOver)
}

script PetalburgWoods_EventScript_FirstSpecialDoubleBattleOver {
	applymovement(OBJ_EVENT_ID_GRUNT_1, PetalburgWoods_Movement_Grunts12DefeatedLockRightWalkLeft)
	applymovement(OBJ_EVENT_ID_GRUNT_2, PetalburgWoods_Movement_Grunts12DefeatedLockRightWalkLeft)
	waitmovement(0)
	applymovement(OBJ_EVENT_ID_GRUNT_1, Common_Movement_FaceUp)
	applymovement(OBJ_EVENT_ID_GRUNT_2, Common_Movement_FaceDown)
	waitmovement(0)
	delay(90)
	applymovement(OBJ_EVENT_ID_GRUNT_1, Common_Movement_FaceRight)
	applymovement(OBJ_EVENT_ID_GRUNT_2, Common_Movement_FaceRight)
	waitmovement(0)
	delay(120)
	applymovement(OBJ_EVENT_ID_GRUNT_1, PetalburgWoods_Movement_Grunt1Flees)
	applymovement(OBJ_EVENT_ID_GRUNT_2, PetalburgWoods_Movement_Grunt2Flees)
	waitmovement(0)
	hideobjectat(OBJ_EVENT_ID_GRUNT_1, MAP_PETALBURG_WOODS)
	hideobjectat(OBJ_EVENT_ID_GRUNT_2, MAP_PETALBURG_WOODS)
	waitmovement(0)
	applymovement(OBJ_EVENT_ID_BRENDAN, Common_Movement_WalkInPlaceLeft)
	msgbox(
		"Pah!\nWhat a bunch of cowards!"
	)
	switch(var(VAR_TEMP_0)) {
		case 1:
			applymovement(OBJ_EVENT_ID_BRENDAN, Common_Movement_FaceDown)
			applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
		case 2:
			applymovement(OBJ_EVENT_ID_BRENDAN, Common_Movement_FaceUp)
			applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceDown)
	}
	waitmovement(0)
	msgbox(PetalburgWoods_Text_BrendanIntro, MSGBOX_YESNO)
	if (!var(VAR_RESULT)) {
		msgbox("No? You you mean you have no fear?")
	}
	msgbox(PetalburgWoods_Text_BrendanIntro2, MSGBOX_NPC)
	end
}

script PetalburgWoods_EventScript_RocketEncounterContinues {
	applymovement(OBJ_EVENT_ID_GRUNT_3, Common_Movement_WalkInPlaceRight)
	msgbox(
		format(
			"We need the goods you've got in that truck, chief.\p"
			"Are you going to give us the code to the safe\p?"
			"Or do I need to introduce you to my Seviper?"
		)
	)
	applymovement(OBJ_EVENT_ID_GRUNT_4, Common_Movement_WalkInPlaceDown)
	msgbox(
		format(
			"And if you still don't want to give it after he delights you with his purple snake,\p"
			"I'll smash your head in."
		)
	)
	applymovement(OBJ_EVENT_ID_DEVON_GUY, Common_Movement_WalkInPlaceUp)
	msgbox(
		format(
			"Look, fellas!\p"
			"I'm just a courier! They don't give me the code.\p"
			"I don't even know what I'm carryi-"
		)
	)
	playse(SE_PIN)
	applymovement(OBJ_EVENT_ID_GRUNT_3, Common_Movement_ExclamationMarkLookUp)
	applymovement(OBJ_EVENT_ID_GRUNT_4, Common_Movement_ExclamationMarkLookUp)
	waitmovement(0)
	applymovement(OBJ_EVENT_ID_GRUNT_4, Common_Movement_WalkInPlaceDown)
	msgbox(
		format("Boss: You wait here.")
	)
	applymovement(OBJ_EVENT_ID_GRUNT_4, Common_Movement_WalkInPlaceUp)
	msgbox(
		format("You must be the ones who scared away our colleagues.")
	)
	applymovement(OBJ_EVENT_ID_GRUNT_3, Common_Movement_ExclamationMarkLookUp)
	applymovement(OBJ_EVENT_ID_GRUNT_4, Common_Movement_ExclamationMarkLookUp)
	msgbox(
		format(
			"And I see you're just a couple of stupid kids!\p"
			"Makes no difference to me - you're both dead."
		)
	)
	goto(PetalburgWoods_EventScript_SecondSpecialDoubleBattle)
}

