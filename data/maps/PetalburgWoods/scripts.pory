const OBJ_EVENT_ID_GRUNT_1		=	13
const OBJ_EVENT_ID_GRUNT_2		=	14
const OBJ_EVENT_ID_BOY			=	16
const OBJ_EVENT_ID_GRUNT_3		=	15
const OBJ_EVENT_ID_GRUNT_4		=	1
const OBJ_EVENT_ID_DEVON_GUY	=	2
const OBJ_EVENT_ID_RANDOM_GIRL	=	11
const OBJ_EVENT_ID_BRENDAN		=	17

mapscripts PetalburgWoods_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		switch(var(VAR_PETALBURG_WOODS_STATE)) {
			case 0:
				call(PetalburgWoods_EventScript_MoveGirlToVar0Var1Position)
			case 1:
				call(PetalburgWoods_EventScript_MoveGirlToVar0Var1Position)
				call(PetalburgWoods_EventScript_MoveGruntsToVar1Positions)
		}
	}
}

script PetalburgWoods_EventScript_FirstEncounter_Position1 {
	setvar(VAR_TEMP_0, 1)
	goto(PetalburgWoods_EventScript_FirstEncounter)
}

script PetalburgWoods_EventScript_FirstEncounter_Position2 {
	setvar(VAR_TEMP_0, 2)
	goto(PetalburgWoods_EventScript_FirstEncounter)
}

script PetalburgWoods_EventScript_FirstEncounter {
	applymovement(OBJ_EVENT_ID_BOY, Common_Movement_WalkInPlaceDown)
	msgbox(
		"Boy: Please let me go!\n"
		"I won't tell anyone, I swear!"
	)
	applymovement(OBJ_EVENT_ID_GRUNT_1, Common_Movement_WalkInPlaceUp)
	msgbox(
		"Sorry, kid, you know how it is.\n"
		"Can't have any loose en-"
	)
	applymovement(OBJ_EVENT_ID_BOY, Common_Movement_ExclamationMarkLookRight)
	msgbox(
		"Boy: Oh, you!\n"
		"Please help meeee!"
	)
	applymovement(OBJ_EVENT_ID_GRUNT_1, Common_Movement_ExclamationMarkLookRight)
	applymovement(OBJ_EVENT_ID_GRUNT_2, Common_Movement_ExclamationMarkLookRight)
	waitmovement(0)
	msgbox(
		"Well, look what we have here..."
	)
	applymovement(OBJ_EVENT_ID_GRUNT_1, PetalburgWoods_Movement_Grunt1MovesIntoBattlePosition)
	applymovement(OBJ_EVENT_ID_GRUNT_2, PetalburgWoods_Movement_Grunt2MovesIntoBattlePosition)
	waitmovement(0)
	msgbox(
		"You trying to be a hero, kid?\p"
		"???: Wait a second, gay boys!"
	)
	addobject(OBJ_EVENT_ID_BRENDAN)
	switch(var(VAR_TEMP_0)) {
		case 1: applymovement(OBJ_EVENT_ID_BRENDAN, PetalburgWoods_Movement_BrendanMovesIntoPosition1)
		case 2: applymovement(OBJ_EVENT_ID_BRENDAN, PetalburgWoods_Movement_BrendanMovesIntoPosition2)
	}
	waitmovement(0)
	goto(PetalburgWoods_EventScript_FirstSpecialDoubleBattle)
	switch(var(VAR_RESULT)){
		case 1:
			msgbox("Double battle success")
			end
		default:
			fadescreen(FADE_TO_BLACK)
			special(SetCB2WhiteOut)
			waitstate
	}
}
script PetalburgWoods_EventScript_FirstSpecialDoubleBattle {
	multi_fixed_2_vs_2(TRAINER_PETALBURG_WOODS_GRUNT_1, PetalburgWoods_Text_Grunt1Defeat, TRAINER_PETALBURG_WOODS_GRUNT_2, PetalburgWoods_Text_Grunt2Defeat, TRAINER_PETALBURG_WOODS_BRENDAN, TRAINER_BACK_PIC_RUBY_SAPPHIRE_BRENDAN)
	switch(var(VAR_RESULT)){
		case 1:
			msgbox("Double battle success", MSGBOX_NPC)
			end
		default:
			fadescreen(FADE_TO_BLACK)
			special(SetCB2WhiteOut)
			waitstate
	}
}

script PetalburgWoods_EventScript_Grunt1Trainer {
	trainerbattle(TRAINER_BATTLE_SET_TRAINER_A, TRAINER_PETALBURG_WOODS_GRUNT_1, 0, PetalburgWoods_Text_Grunt1Defeat, PetalburgWoods_Text_Grunt1Defeat)
}

script PetalburgWoods_EventScript_Grunt2Trainer {
	trainerbattle(TRAINER_BATTLE_SET_TRAINER_B, TRAINER_PETALBURG_WOODS_GRUNT_2, 0, PetalburgWoods_Text_Grunt2Defeat, PetalburgWoods_Text_Grunt2Defeat)
}

movement PetalburgWoods_Movement_Grunt1MovesIntoBattlePosition {
	walk_down
	walk_right * 2
}

movement PetalburgWoods_Movement_Grunt2MovesIntoBattlePosition {
	walk_right
	walk_down
	face_right
}

movement PetalburgWoods_Movement_BrendanMovesIntoPosition1 {
	walk_fast_up * 2
	walk_fast_left * 2
	walk_fast_up * 5
	walk_fast_left
	walk_fast_up
	walk_fast_left
}

movement PetalburgWoods_Movement_BrendanMovesIntoPosition2 {
	walk_fast_up * 2
	walk_fast_left * 2
	walk_fast_up * 5
	walk_fast_left * 2
}

script PetalburgWoods_EventScript_MoveGirlToVar0Var1Position {
	setobjectxyperm(OBJ_EVENT_ID_RANDOM_GIRL, 16, 26)
	setobjectmovementtype(OBJ_EVENT_ID_RANDOM_GIRL, MOVEMENT_TYPE_LOOK_AROUND)
	return
}

script PetalburgWoods_EventScript_MoveGruntsToVar1Positions {
	setobjectxyperm(OBJ_EVENT_ID_GRUNT_1, 11, 30)
	setobjectxyperm(OBJ_EVENT_ID_GRUNT_2, 12, 29)
	setobjectmovementtype(OBJ_EVENT_ID_GRUNT_1, MOVEMENT_TYPE_FACE_DOWN)
	setobjectmovementtype(OBJ_EVENT_ID_GRUNT_2, MOVEMENT_TYPE_FACE_DOWN)
	return
}

script PetalburgWoods_EventScript_Sign {
	msgbox(PetalburgWoods_Text_Sign, MSGBOX_SIGN)
}

script PetalburgWoods_EventScript_Lyle {
	trainerbattle_single(TRAINER_LYLE, PetalburgWoods_Text_GoBugPokemonTeam, PetalburgWoods_Text_ICouldntWin)
	msgbox(PetalburgWoods_Text_ImOutOfPokeBalls, MSGBOX_AUTOCLOSE)
	end
}

script PetalburgWoods_EventScript_James {
	trainerbattle_single(TRAINER_JAMES_1, PetalburgWoods_Text_InstantlyPopularWithBugPokemon, PetalburgWoods_Text_CantBePopularIfILose, PetalburgWoods_EventScript_TryRegisterJames)
	specialvar(VAR_RESULT, ShouldTryRematchBattle)
	if (var(VAR_RESULT)) {
		goto(PetalburgWoods_EventScript_JamesRematch)
	}
	setvar(VAR_0x8004, TRAINER_JAMES_1)
	specialvar(VAR_RESULT, IsTrainerRegistered)
	if (!var(VAR_RESULT)) {
		goto(PetalburgWoods_EventScript_TryRegisterJames2)
	}
	msgbox(PetalburgWoods_Text_PeopleRespectYou, MSGBOX_DEFAULT)
	release
	end
}

script PetalburgWoods_EventScript_TryRegisterJames {
	special(PlayerFaceTrainerAfterBattle)
	waitmovement(0)
	if (flag(FLAG_HAS_MATCH_CALL)) {
		goto(PetalburgWoods_EventScript_RegisterJames)
	}
	release
	end
}

script PetalburgWoods_EventScript_JamesRematch {
	trainerbattle_rematch(TRAINER_JAMES_1, PetalburgWoods_Text_MyPokemonHaveGrown, PetalburgWoods_Text_CantBePopularIfILose)
	msgbox(PetalburgWoods_Text_IveBeenTrainingHard, MSGBOX_AUTOCLOSE)
	end
}

script PetalburgWoods_EventScript_TryRegisterJames2 {
	if (flag(FLAG_HAS_MATCH_CALL)) {
		goto(PetalburgWoods_EventScript_RegisterJames)
	}
	msgbox(PetalburgWoods_Text_PeopleRespectYou, MSGBOX_DEFAULT)
	release
	end
}

script PetalburgWoods_EventScript_RegisterJames {
	msgbox(PetalburgWoods_Text_IWantRematch, MSGBOX_DEFAULT)
	register_matchcall(TRAINER_JAMES_1)
	release
	end
}

script PetalburgWoods_EventScript_Boy1 {
	msgbox(PetalburgWoods_Text_StayOutOfTallGrass, MSGBOX_NPC)
	end
}

script PetalburgWoods_EventScript_Boy2 {
	msgbox(PetalburgWoods_Text_HiddenItemsExplanation, MSGBOX_NPC)
	end
}

// Episode text
text PetalburgWoods_Text_Grunt1Defeat {
	format("Useless bat! First it gives me some weird cough, now this!")
}

text PetalburgWoods_Text_Grunt2Defeat {
	format("Hmm, maybe actual training is better than Rare Candies...")
}

// Random text

text PetalburgWoods_Text_Sign {
	"Petalburg Woods\n"
	"{DOWN_ARROW}Petalburg"
}

text PetalburgWoods_Text_GoBugPokemonTeam {
	"I caught a whole bunch of monsters!\p"
	"Go, go, go!\n"
	"My Bug team!"
}

text PetalburgWoods_Text_ICouldntWin {
	"I have all these monsters,\n"
	"but I couldn't win…"
}

text PetalburgWoods_Text_ImOutOfPokeBalls {
	"I caught a bunch of monsters.\n"
	"Now I'm out of Monster Balls..."
}

text PetalburgWoods_Text_InstantlyPopularWithBugPokemon {
	"If you take Bug monsters to school,\n"
	"you get to be instantly popular!"
}

text PetalburgWoods_Text_CantBePopularIfILose {
	"I can't be popular if I lose."
}

text PetalburgWoods_Text_PeopleRespectYou {
	"If you have a big Bug monster,\n"
	"people respect you for it."
}

text PetalburgWoods_Text_IWantRematch {
	"I want a rematch when my Bug\n"
	"monsters grow up!\p"
	"I'm registering you in my PokéNav!"
}

text PetalburgWoods_Text_MyPokemonHaveGrown {
	"My Bug monsters have grown.\n"
	"I'll be popular again!"
}

text PetalburgWoods_Text_IveBeenTrainingHard {
	"You get to be popular if you have\n"
	"strong monsters, right?\l"
	"So, I've been training hard."
}

text PetalburgWoods_Text_StayOutOfTallGrass {
	"Yo, there!\n"
	"Your monsters doing okay?\p"
	"If your monsters are weak and you want\n"
	"to avoid battles, you should stay out\l"
	"of tall grass."
}

text PetalburgWoods_Text_HiddenItemsExplanation {
	"Sometimes, there are things on the\n"
	"ground even if you can't see them.\p"
	"That's why I always check where I'm\n"
	"walking."
}