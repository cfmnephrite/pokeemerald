	// multi_fixed_2_vs_2(TRAINER_PETALBURG_WOODS_GRUNT_3, PetalburgWoods_Text_Grunt3Defeat, TRAINER_PETALBURG_WOODS_GRUNT_3, PetalburgWoods_Text_Grunt3Defeat, TRAINER_PETALBURG_WOODS_BRENDAN, TRAINER_BACK_PIC_RUBY_SAPPHIRE_BRENDAN)
